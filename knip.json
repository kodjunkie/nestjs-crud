{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/util": {
      "project": ["src/**/*.ts"]
    },
    "packages/request": {
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": [
        "test/**/*.spec.ts",
        "test/parity/**/*.ts",
        "test/__stubs__/**/*.ts",
        "test/__fixture__/**/*.ts",
        "test/__shared-fixture__/**/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["express"]
    },
    "packages/typeorm": {
      "entry": [
        "src/query/index.ts",
        "test/**/*.spec.ts",
        "test/__fixture__/**/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/drizzle": {
      "entry": [
        "src/query/index.ts",
        "test/**/*.spec.ts",
        "test/__fixture__/**/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/mikro-orm": {
      "entry": [
        "src/query/index.ts",
        "test/**/*.spec.ts",
        "test/__fixture__/**/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/prisma": {
      "entry": [
        "src/query/index.ts",
        "test/**/*.spec.ts",
        "test/__fixture__/**/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    ".": {
      "entry": ["examples/**/*.ts"],
      "project": ["*.js", "examples/**/*.ts"],
      "ignoreDependencies": [
        "pluralize",
        "swagger-ui-express",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "conventional-changelog-cli",
        "eslint-config-airbnb-base",
        "eslint-plugin-import",
        "nodemon",
        "cz-conventional-changelog",
        "@nestjs-crud/core",
        "@nestjs-crud/util",
        "@nestjs-crud/request",
        "@nestjs-crud/typeorm",
        "@nestjs-crud/drizzle",
        "@nestjs-crud/mikro-orm",
        "@nestjs-crud/prisma"
      ]
    }
  },
  "rules": {
    "duplicates": "off",
    "enumMembers": "off",
    "optionalPeerDependencies": "off"
  },
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": []
}
