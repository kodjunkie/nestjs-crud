{
  "name": "nestjs-crud",
  "version": "2.0.0",
  "description": "Nest CRUD for RESTful APIs",
  "license": "MIT",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "rebuild": "yarn clean && yarn build",
    "build": "npx mrepo build",
    "clean": "npx mrepo clean && npx rimraf ./.mrepo",
    "test": "npx mrepo test",
    "test:coverage": "yarn test:all --coverage",
    "test:typeorm:postgres": "yarn db:prepare:typeorm:postgres && npx jest --config packages/typeorm/jest.config.js",
    "test:typeorm:mysql": "yarn db:prepare:typeorm:mysql && TYPEORM_CONNECTION=mysql npx jest --config packages/typeorm/jest.config.js",
    "test:drizzle:postgres": "yarn db:prepare:drizzle:postgres && DRIZZLE_DIALECT=postgres npx jest --config packages/drizzle/jest.config.js",
    "test:drizzle:mysql": "yarn db:prepare:drizzle:mysql && DRIZZLE_DIALECT=mysql npx jest --config packages/drizzle/jest.config.js",
    "test:parity": "npx jest --config jest.config.js packages/core/test/parity",
    "test:all": "yarn test:parity && yarn test:typeorm:postgres && yarn test:typeorm:mysql && yarn test:drizzle:postgres && yarn test:drizzle:mysql && yarn test:mikro-orm:postgres && yarn test:mikro-orm:mysql",
    "test:postgres": "yarn db:prepare:typeorm:postgres && yarn test",
    "test:mysql": "yarn db:prepare:typeorm:mysql && TYPEORM_CONNECTION=mysql yarn test",
    "test:mikro-orm": "NODE_OPTIONS=--experimental-vm-modules npx jest --config packages/mikro-orm/jest.config.js",
    "start:typeorm": "cd examples/typeorm-demo && yarn start:dev",
    "db:cli:typeorm": "cd ./packages/typeorm/test/__fixture__/app && node ../../../../../node_modules/ts-node/dist/bin.js --project tsconfig.cli.json -r tsconfig-paths/register ../../../../../node_modules/typeorm/cli.js",
    "db:sync:typeorm": "yarn db:cli:typeorm schema:sync",
    "db:drop:typeorm": "yarn db:cli:typeorm schema:drop",
    "db:seeds:typeorm": "yarn db:cli:typeorm migration:run",
    "db:prepare:typeorm:postgres": "yarn db:drop:typeorm -d=orm.postgres.ts && yarn db:sync:typeorm -d=orm.postgres.ts && yarn db:seeds:typeorm -d=orm.postgres.ts",
    "db:prepare:typeorm:mysql": "yarn db:drop:typeorm -d=orm.mysql.ts && yarn db:sync:typeorm -d=orm.mysql.ts && yarn db:seeds:typeorm -d=orm.mysql.ts",
    "db:prepare:drizzle:postgres": "npx ts-node -T --project packages/drizzle/tsconfig.json packages/drizzle/test/__fixture__/seeds.ts postgres",
    "db:prepare:drizzle:mysql": "npx ts-node -T --project packages/drizzle/tsconfig.json packages/drizzle/test/__fixture__/seeds.ts mysql",
    "db:prepare:mikro-orm:postgres": "npx tsx packages/mikro-orm/test/__fixture__/seeds.ts postgres",
    "db:prepare:mikro-orm:mysql": "npx tsx packages/mikro-orm/test/__fixture__/seeds.ts mysql",
    "test:mikro-orm:postgres": "yarn db:prepare:mikro-orm:postgres && NODE_OPTIONS=--experimental-vm-modules MIKRO_ORM_DIALECT=postgres npx jest --config packages/mikro-orm/jest.config.js",
    "test:mikro-orm:mysql": "yarn db:prepare:mikro-orm:mysql && NODE_OPTIONS=--experimental-vm-modules MIKRO_ORM_DIALECT=mysql npx jest --config packages/mikro-orm/jest.config.js",
    "prisma:generate:postgres": "npx prisma generate --schema=packages/prisma/test/__fixture__/schema.postgres.prisma",
    "prisma:generate:mysql": "npx prisma generate --schema=packages/prisma/test/__fixture__/schema.mysql.prisma",
    "validate:prisma:provider-switch": "yarn prisma:generate:postgres && yarn prisma:generate:mysql",
    "db:prepare:prisma:postgres": "npx ts-node -T --project packages/prisma/tsconfig.json packages/prisma/test/__fixture__/seeds.ts postgres",
    "db:prepare:prisma:mysql": "npx ts-node -T --project packages/prisma/tsconfig.json packages/prisma/test/__fixture__/seeds.ts mysql",
    "audit:prisma:drift": "npx ts-node -T --project packages/prisma/tsconfig.json packages/prisma/test/__fixture__/schema-drift-audit.ts",
    "test:prisma:postgres": "yarn audit:prisma:drift && yarn prisma:generate:postgres && yarn db:prepare:prisma:postgres && PRISMA_PROVIDER=postgresql DATABASE_URL='postgresql://root:root@127.0.0.1:5455/nestjs_crud?schema=prisma_smoke' npx jest --config packages/prisma/jest.config.js",
    "test:prisma:mysql": "yarn audit:prisma:drift && yarn prisma:generate:mysql && yarn db:prepare:prisma:mysql && PRISMA_PROVIDER=mysql DATABASE_URL=mysql://root:nestjs_crud@127.0.0.1:3316/nestjs_crud_prisma npx jest --config packages/prisma/jest.config.js",
    "format": "npx pretty-quick --pattern \"packages/**/!(*.d).ts\"",
    "lint": "npx eslint \"packages/**/!(*.d).ts\" --fix",
    "knip": "npx knip",
    "knip:fix": "npx knip --fix",
    "commit": "npx git-cz",
    "prepare": "npx husky install",
    "release": "mrepo release",
    "release:alpha": "yarn release prerelease --preid alpha --dist-tag alpha",
    "release:beta": "yarn release prerelease --preid beta --dist-tag beta"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@mikro-orm/core": "^7.0.0",
    "@mikro-orm/knex": "^6.0.0",
    "@mikro-orm/mysql": "^7.0.0",
    "@mikro-orm/postgresql": "^7.0.0",
    "@mikro-orm/sqlite": "^7.0.0",
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/testing": "^11.1.13",
    "@nestjs/typeorm": "^11.0.0",
    "@zmotivat0r/mrepo": "0.8.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "drizzle-orm": "^0.45.1",
    "mysql2": "3.17.2",
    "pg": "8.18.0",
    "pluralize": "8.0.0",
    "qs": "6.15.0",
    "redis": "5.11.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@prisma/client": "^7.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.19.10",
    "@types/qs": "6.14.0",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "better-sqlite3": "^12.9.0",
    "commitizen": "4.3.1",
    "conventional-changelog-cli": "5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "globals": "^17.3.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "jest-extended": "7.0.0",
    "knip": "^6",
    "lerna": "9.0.4",
    "nodemon": "3.1.11",
    "prettier": "3.8.1",
    "pretty-quick": "4.2.2",
    "prisma": "^7.0.0",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsconfig-extends": "1.0.1",
    "tsconfig-paths": "4.2.0",
    "tsx": "^4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "author": {
    "name": "Lawrence Onah",
    "email": "paplow01@gmail.com"
  }
}
