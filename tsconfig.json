{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "removeComments": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2018",
    "sourceMap": true,
    "allowJs": false,
    "skipLibCheck": false,
    "composite": true,
    "strict": false,
    "types": ["node"],
    "paths": {
      "typeorm": ["./node_modules/typeorm"],
      "typeorm/*": ["./node_modules/typeorm/*"],
      "@nestjs-crud/core": ["./packages/core/src"],
      "@nestjs-crud/typeorm": ["./packages/typeorm/src"],
      "@nestjs-crud/request": ["./packages/request/src"],
      "@nestjs-crud/util": ["./packages/util/src"],
      "@nestjs-crud/core/*": ["./packages/core/src/*"],
      "@nestjs-crud/typeorm/*": ["./packages/typeorm/src/*"],
      "@nestjs-crud/request/*": ["./packages/request/src/*"],
      "@nestjs-crud/util/*": ["./packages/util/src/*"],
      "@nestjs-crud/drizzle": ["./packages/drizzle/src"],
      "@nestjs-crud/drizzle/*": ["./packages/drizzle/src/*"],
      "@nestjs-crud/mikro-orm": ["./packages/mikro-orm/src"],
      "@nestjs-crud/mikro-orm/*": ["./packages/mikro-orm/src/*"],
      "@nestjs-crud/prisma": ["./packages/prisma/src"],
      "@nestjs-crud/prisma/*": ["./packages/prisma/src/*"]
    }
  },
  "exclude": ["opensrc", "**/lib", "**/*.tsbuildinfo"],
  "files": [],
  "references": [
    { "path": "packages/util" },
    { "path": "packages/request" },
    { "path": "packages/core" },
    { "path": "packages/typeorm" },
    { "path": "packages/drizzle" },
    { "path": "packages/mikro-orm" },
    { "path": "packages/prisma" }
  ]
}
